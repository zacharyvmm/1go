{
  "name": "@zacharymm/scah",
  "version": "0.0.21",
  "description": "scah (scan HTML) nodejs bindings",
  "main": "index.js",
  "license": "MIT",
  "keywords": [
    "htmlparser",
    "css",
    "selector",
    "scraper",
    "parser",
    "sax",
    "xml",
    "html"
  ],
  "files": [
    "index.d.ts",
    "index.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zacharyvmm/scah.git"
  },
  "napi": {
    "packageName": "@zacharymm/scah",
    "binaryName": "scah",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin"
    ]
  },
  "engines": {
    "node": ">= 12.22.0 < 13 || >= 14.17.0 < 15 || >= 15.12.0 < 16 || >= 16.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "bun benchmark/bench.ts",
    "bench:image": "bun run bench:image:simple && bun run bench:image:whatwg && bun run bench:image:nested",
    "bench:json": "bun run bench:json:simple && bun run bench:json:whatwg && bun run bench:json:nested",
    "bench:image:first": "bun benchmark/bench.ts --scenario simple-first --json ./benchmark/results/synthetic_first.json --image ./benchmark/images/synthetic_first.png",
    "bench:image:simple": "bun benchmark/bench.ts --scenario simple-all --json ./benchmark/results/synthetic.json --image ./benchmark/images/synthetic.png",
    "bench:image:whatwg": "bun benchmark/bench.ts --scenario whatwg-all-links --json ./benchmark/results/whatwg.json --image ./benchmark/images/whatwg.png",
    "bench:image:nested": "bun benchmark/bench.ts --scenario nested-all --json ./benchmark/results/nested.json --image ./benchmark/images/nested.png",
    "bench:json:first": "bun benchmark/bench.ts --scenario simple-first --json ./benchmark/results/synthetic_first.json",
    "bench:json:simple": "bun benchmark/bench.ts --scenario simple-all --json ./benchmark/results/synthetic.json",
    "bench:json:whatwg": "bun benchmark/bench.ts --scenario whatwg-all-links --json ./benchmark/results/whatwg.json",
    "bench:json:nested": "bun benchmark/bench.ts --scenario nested-all --json ./benchmark/results/nested.json",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "bun run format:prettier && bun run format:rs && bun run format:toml",
    "format:prettier": "prettier . -w",
    "format:toml": "taplo format",
    "format:rs": "cargo fmt",
    "lint": "oxlint .",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "bun test",
    "preversion": "napi build --platform && git add .",
    "version": "napi version",
    "prepare": "husky"
  },
  "devDependencies": {
    "@emnapi/core": "^1.5.0",
    "@emnapi/runtime": "^1.5.0",
    "@napi-rs/cli": "^3.2.0",
    "@taplo/cli": "^0.7.0",
    "@tybys/wasm-util": "^0.10.0",
    "@types/jsdom": "^28.0.0",
    "bun-types": "^1.3.9",
    "cheerio": "^1.2.0",
    "happy-dom": "^20.7.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "linkedom": "^0.18.12",
    "lint-staged": "^16.1.6",
    "node-html-parser": "^7.0.2",
    "oxlint": "^1.14.0",
    "prettier": "^3.6.2",
    "mitata": "^1.0.10",
    "typescript": "^5.9.2"
  },
  "lint-staged": {
    "*.@(js|ts|tsx)": [
      "oxlint --fix"
    ],
    "*.@(js|ts|tsx|yml|yaml|md|json)": [
      "prettier --write"
    ],
    "*.toml": [
      "taplo format"
    ]
  },
  "prettier": {
    "printWidth": 120,
    "semi": false,
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "optionalDependencies": {
    "@zacharymm/scah-win32-x64-msvc": "0.0.21",
    "@zacharymm/scah-darwin-x64": "0.0.21",
    "@zacharymm/scah-linux-x64-gnu": "0.0.21",
    "@zacharymm/scah-linux-arm64-gnu": "0.0.21",
    "@zacharymm/scah-darwin-arm64": "0.0.21"
  }
}
